generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  normalizedName  String   @unique @map("normalized_name")
  industry        String
  headquarters    String
  foundedYear     Int?     @map("founded_year")
  headcountRange  String?  @map("headcount_range")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  logo            String?  @map("logo")
  salaries        Salary[]

  @@map("companies")
}

model Salary {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  role              String
  level             Level
  location          String
  currency          Currency
  experienceYears   Int      @map("experience_years")
  baseSalary        BigInt   @map("base_salary")
  bonus             BigInt   @default(0) @map("bonus")
  stock             BigInt   @default(0) @map("stock")
  totalCompensation BigInt   @map("total_compensation")
  source            Source
  confidenceScore   Decimal  @map("confidence_score") @db.Decimal(3, 2)
  isVerified        Boolean  @default(false) @map("is_verified")
  submittedAt       DateTime @default(now()) @map("submitted_at")
  company           Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, level, location])
  @@index([totalCompensation])
  @@index([submittedAt])
  @@index([location, level])
  @@map("salaries")
}

enum Level {
  L3
  L4
  L5
  L6
  SDE_I
  SDE_II
  SDE_III
  STAFF
  PRINCIPAL
  IC4
  IC5
}

enum Currency {
  INR
  USD
  GBP
  EUR
}

enum Source {
  CONTRIBUTOR
  SCRAPED
  AI_INFERRED
}
